# ------------------------------------------------------------------
# Copy this file to ".env" and fill in the values.
# NEVER upload the real .env file to GitHub (it is in .gitignore).
# ------------------------------------------------------------------

# development | production | test
NODE_ENV=development

# Port of the server (Render sets PORT automatically)
PORT=3000

# PostgreSQL connection string.
# Local (docker compose up -d):
DATABASE_URL="postgresql://codenest:codenest@localhost:5432/codenest?schema=public"
# Cloud example (Neon):  postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Secret used to sign login tokens. At least 32 random characters!
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string-of-at-least-32-characters"

# How long a login token is valid: 15m, 24h, 7d ...
JWT_EXPIRES_IN=24h

# Which websites may call the API. * = everyone (fine for development).
# Production example: https://my-codenest.vercel.app,http://localhost:5173
CORS_ORIGIN=*

# bcrypt cost (10 is a good default)
BCRYPT_ROUNDS=10

# --- Image storage: Cloudflare R2 (S3-compatible) ---
# Image FILES live in R2; PostgreSQL keeps only the object key + metadata.
# Get these from the Cloudflare dashboard (R2 → Manage API tokens). Keep them secret!
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=codenest-images
# Optional: only for a different endpoint (e.g. EU jurisdiction) — otherwise built from R2_ACCOUNT_ID
R2_ENDPOINT=
# Optional: public bucket URL / custom domain. Leave empty to serve images via short-lived signed URLs.
R2_PUBLIC_BASE_URL=
# How long a signed image URL stays valid (seconds)
IMAGE_URL_TTL_SECONDS=3600
# For local experiments without R2 you may use STORAGE_DRIVER=memory (images vanish on restart; never in production).

# --- Seed settings (used only when NODE_ENV=production) ---
# Creates an admin account with a password YOU choose. Leave empty to skip.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# If set, creates demo users (noa/dan/yael@codenest.dev) + demo posts with THIS password.
SEED_DEMO_PASSWORD=
